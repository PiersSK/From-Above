  m_Name: 
  m_EditorClassIdentifier: 
  promptMessage: Read Letter From CM
  requirementsNotMetMessage: 
  isInteractable: 1
  hasText: 1
  textTranscript: "Hello my friend. \\n\\nI can\u2019t believe it\u2019s come to
    this, but I know you\u2019ll look out and do the right thing. \\n\\nYou have
    to be sure of what you\u2019re doing, because it will be your hand on the hilt.
    \\n\\nYou have always, at the end of it all, got a choice.\\n\\n\\t\\t\\tC\r\n"
  sfx: {fileID: 8300000, guid: 74f3f3c7c587add498e29ad31dbfe177, type: 3}
